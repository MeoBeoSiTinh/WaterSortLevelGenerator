"use strict";

const DEFAULTS = Object.freeze({
  megaCandidateAttemptCount: 48,
  minMegaActiveBottleCount: 14,
  maxMegaActiveBottleCount: 30,
  minMegaBlockerColorCount: 6,
  maxMegaBlockerColorCount: 9,
  minMegaNormalHelperCount: 1,
  maxMegaNormalHelperCount: 2,
  maxMegaTargetGroupSize: 2,
  minMegaBuriedTargetRatio: 0.85,
  minMegaDeepBuriedTargetRatio: 0.35,
  minMegaUniqueTopColorCount: 4,
  maxMegaTopColorShare: 0.25,
  minMegaUniqueBottlePatternRatio: 1,
  minMegaMovesBeforeFirstFill: 3,
  minMegaCrossBottleBlockerMoves: 3,
  minMegaNonMegaMoveRatio: 0.4,
  maxMegaConsecutiveFillMoves: 3,
  megaSolverMaxStates: 60000,
  megaSolverMaxDepth: 160,
  maxAdjacentPairRepeats: 3,
  minMegaActiveFillRatio: 0.5,
  targetMegaActiveFillRatio: 0.85,
  maxMegaActiveFreeRatio: 0.2,
  maxMegaSparseBottleRatio: 0.15,
  maxMegaSingleLayerBottleCount: 0,
  megaFreeCapacityConcentrationRatio: 0.65,
});

function buildMegaLevelV2(config, band, levelNumber, seed, paletteSize) {
  const profile = megaProfile(config, band, levelNumber, paletteSize);
  const attempts = Math.max(1, profile.megaCandidateAttemptCount);
  let best = null;
  const failures = new Map();

  for (let attempt = 0; attempt < attempts; attempt++) {
    const random = rng(seedFor(seed, levelNumber, attempt, 0x6D454741));
    try {
      const candidate = buildMegaCandidate(config, band, levelNumber, random, profile, paletteSize);
      validateMegaCandidate(candidate, profile);
      const solved = solveMegaCandidate(candidate, profile);
      if (!solved.success) {
        countFailure(failures, solved.status);
        continue;
      }

      const replay = replayMegaSolutionExact(candidate, solved.solution.moves);
      if (!replay.success) {
        countFailure(failures, `replay:${replay.reason}`);
        continue;
      }

      const metrics = evaluateMegaCandidate(candidate, solved.solution.moves, solved.visitedStates);
      const quality = scoreMegaCandidate(metrics, profile, band);
      if (!quality.accepted) {
        countFailure(failures, quality.reason);
        continue;
      }

      const accepted = {
        ...candidate,
        metrics,
        solutionMoveLists: [solved.solution.moves],
        solutionStepCount: solved.solution.stepCount,
        solverVisitedStates: solved.visitedStates,
        qualityScore: quality.score,
      };
      if (best == null || accepted.qualityScore > best.qualityScore) best = accepted;
    } catch (error) {
      countFailure(failures, error instanceof Error ? error.message : String(error));
    }
  }

  if (best == null) {
    const reasons = Array.from(failures.entries())
      .sort((left, right) => right[1] - left[1])
      .slice(0, 6)
      .map(([reason, count]) => `${reason} (${count})`)
      .join("; ");
    throw new Error(`Mega V2 failed to produce a valid candidate for level ${levelNumber}: ${reasons}`);
  }

  return {
    capacity: best.defaultCapacity,
    board: best.board.map(bottle => bottle.slice()),
    solutionMoveLists: best.solutionMoveLists,
    megaBottleIndex: best.megaBottleIndex,
    megaCapacity: best.megaCapacity,
    megaTargetColor: best.targetColor,
    metrics: best.metrics,
  };
}

function megaProfile(config, band, levelNumber, paletteSize) {
  const hard = String(band.name || "").toLowerCase() === "main" && levelNumber % 5 !== 0;
  const get = (name, fallback) => Number.isFinite(band[name]) ? band[name] : fallback;
  const maxBlockerColors = hard ? 12 : DEFAULTS.maxMegaBlockerColorCount;
  return {
    hard,
    megaCandidateAttemptCount: get("megaCandidateAttemptCount", DEFAULTS.megaCandidateAttemptCount),
    minMegaActiveBottleCount: get("minMegaActiveBottleCount", hard ? 18 : DEFAULTS.minMegaActiveBottleCount),
    maxMegaActiveBottleCount: Math.min(get("maxMegaActiveBottleCount", hard ? 34 : DEFAULTS.maxMegaActiveBottleCount), Math.max(1, config.maxBottleCount - 3)),
    minMegaBlockerColorCount: get("minMegaBlockerColorCount", hard ? 8 : DEFAULTS.minMegaBlockerColorCount),
    maxMegaBlockerColorCount: Math.min(get("maxMegaBlockerColorCount", maxBlockerColors), Math.max(1, paletteSize - 1)),
    minMegaNormalHelperCount: get("minMegaNormalHelperCount", hard ? 1 : DEFAULTS.minMegaNormalHelperCount),
    maxMegaNormalHelperCount: get("maxMegaNormalHelperCount", hard ? 2 : DEFAULTS.maxMegaNormalHelperCount),
    maxMegaTargetGroupSize: Math.max(1, Math.min(3, get("maxMegaTargetGroupSize", DEFAULTS.maxMegaTargetGroupSize))),
    minMegaBuriedTargetRatio: get("minMegaBuriedTargetRatio", hard ? 1 : DEFAULTS.minMegaBuriedTargetRatio),
    minMegaDeepBuriedTargetRatio: get("minMegaDeepBuriedTargetRatio", hard ? 0.5 : DEFAULTS.minMegaDeepBuriedTargetRatio),
    minMegaUniqueTopColorCount: get("minMegaUniqueTopColorCount", hard ? 5 : DEFAULTS.minMegaUniqueTopColorCount),
    maxMegaTopColorShare: get("maxMegaTopColorShare", hard ? 0.2 : DEFAULTS.maxMegaTopColorShare),
    minMegaUniqueBottlePatternRatio: get("minMegaUniqueBottlePatternRatio", DEFAULTS.minMegaUniqueBottlePatternRatio),
    minMegaMovesBeforeFirstFill: get("minMegaMovesBeforeFirstFill", DEFAULTS.minMegaMovesBeforeFirstFill),
    minMegaCrossBottleBlockerMoves: get("minMegaCrossBottleBlockerMoves", hard ? 4 : DEFAULTS.minMegaCrossBottleBlockerMoves),
    minMegaNonMegaMoveRatio: get("minMegaNonMegaMoveRatio", DEFAULTS.minMegaNonMegaMoveRatio),
    maxMegaConsecutiveFillMoves: get("maxMegaConsecutiveFillMoves", DEFAULTS.maxMegaConsecutiveFillMoves),
    megaSolverMaxStates: get("megaSolverMaxStates", DEFAULTS.megaSolverMaxStates),
    megaSolverMaxDepth: get("megaSolverMaxDepth", DEFAULTS.megaSolverMaxDepth),
    maxAdjacentPairRepeats: DEFAULTS.maxAdjacentPairRepeats,
    minMegaActiveFillRatio: get("minMegaActiveFillRatio", DEFAULTS.minMegaActiveFillRatio),
    targetMegaActiveFillRatio: get("targetMegaActiveFillRatio", hard ? 0.9 : DEFAULTS.targetMegaActiveFillRatio),
    maxMegaActiveFreeRatio: get("maxMegaActiveFreeRatio", hard ? 0.15 : DEFAULTS.maxMegaActiveFreeRatio),
    maxMegaSparseBottleRatio: get("maxMegaSparseBottleRatio", hard ? 0.1 : DEFAULTS.maxMegaSparseBottleRatio),
    maxMegaSingleLayerBottleCount: Math.max(0, Math.floor(get("maxMegaSingleLayerBottleCount", DEFAULTS.maxMegaSingleLayerBottleCount))),
    megaFreeCapacityConcentrationRatio: get("megaFreeCapacityConcentrationRatio", DEFAULTS.megaFreeCapacityConcentrationRatio),
  };
}

function buildMegaCandidate(config, band, levelNumber, random, profile, paletteSize) {
  const defaultCapacity = Math.max(2, Math.min(5, weighted(random, band.capacityWeights || [], config.defaultBottleCapacity || 4)));
  const minConfiguredCapacity = Math.max(12, Math.min(20, band.minMegaBottleCapacity || 12));
  const maxCapacityByStepBudget = Math.max(12, Math.floor((band.maxShortestStepCount || 80) / 3) + 1);
  const maxConfiguredCapacity = Math.max(minConfiguredCapacity, Math.min(20, band.maxMegaBottleCapacity || 20, maxCapacityByStepBudget));
  const megaCapacity = randomInt(random, minConfiguredCapacity, maxConfiguredCapacity);
  const palette = shuffle(Array.from({ length: paletteSize }, (_, index) => index), random);
  const targetColor = palette[0];
  const blockerColorCount = randomInt(
    random,
    Math.min(profile.minMegaBlockerColorCount, profile.maxMegaBlockerColorCount),
    profile.maxMegaBlockerColorCount);
  const blockerPalette = palette.filter(color => color !== targetColor).slice(0, blockerColorCount);
  const starterTargetLayers = random() < 0.18 && megaCapacity > 12 ? 2 : 1;
  const remainingTargets = megaCapacity - starterTargetLayers;
  const targetGroups = distributeTargetGroupsV2(remainingTargets, defaultCapacity, profile, random);
  const helperCount = randomInt(random, profile.minMegaNormalHelperCount, profile.maxMegaNormalHelperCount);
  const board = [Array(starterTargetLayers).fill(targetColor)];
  const metadata = {
    targetGroupSources: [],
    normalHelperIndexes: [],
    blockerOnlyIndexes: [],
    targetGroups: [],
  };
  const blockerLoads = new Map(blockerPalette.map(color => [color, 0]));
  const patternSet = new Set();
  const pairCounts = new Map();

  for (let source = 0; source < targetGroups.length; source++) {
    const groupSize = targetGroups[source];
    const maxDepth = defaultCapacity - groupSize;
    const needDeep = source / targetGroups.length < profile.minMegaDeepBuriedTargetRatio;
    const minDepth = needDeep && maxDepth >= 2 ? 2 : 1;
    const blockerDepth = Math.max(minDepth, randomInt(random, minDepth, maxDepth));
    const fillerCount = Math.max(0, defaultCapacity - groupSize - blockerDepth);
    const bottle = [];
    for (let layer = 0; layer < fillerCount; layer++) bottle.push(pickBalancedColor(blockerPalette, blockerLoads, random));
    for (let layer = 0; layer < groupSize; layer++) bottle.push(targetColor);
    for (let layer = 0; layer < blockerDepth; layer++) {
      const color = pickBalancedColor(blockerPalette, blockerLoads, random);
      blockerLoads.set(color, blockerLoads.get(color) + 1);
      bottle.push(color);
    }
    mutateUntilDiverse(bottle, targetColor, blockerPalette, patternSet, pairCounts, random, defaultCapacity);
    const index = board.length;
    board.push(bottle);
    metadata.targetGroupSources.push(index);
    metadata.targetGroups.push({ bottleIndex: index, groupSize, blockerDepth });
  }

  const densityBudget = calculateMegaActiveBottleBudget({
    targetSourceCount: metadata.targetGroupSources.length,
    targetSourceLayerCount: metadata.targetGroupSources.length * defaultCapacity,
    blockerColorCount: blockerPalette.length,
    capacity: defaultCapacity,
    helperCount,
    profile,
    maxPhysicalBottles: Math.min(config.maxBottleCount || 40, 40),
  });
  for (let i = 0; i < densityBudget.blockerOnlyBottleCount; i++) {
    const color = blockerPalette[i % blockerPalette.length];
    const preferredLength = chooseDenseBlockerBottleLength(defaultCapacity, random);
    const bottle = makeBlockerOnlyBottle(color, blockerPalette, patternSet, pairCounts, random, defaultCapacity, preferredLength);
    const index = board.length;
    board.push(bottle);
    metadata.blockerOnlyIndexes.push(index);
  }

  rebalanceMegaDensity({ board, capacities: board.map((_, index) => index === 0 ? megaCapacity : defaultCapacity), megaBottleIndex: 0, targetColor, metadata }, profile, random);

  for (let i = 0; i < helperCount; i++) {
    metadata.normalHelperIndexes.push(board.length);
    board.push([]);
  }

  if (board.length + 3 > Math.min(config.maxBottleCount || 40, 40)) {
    throw new Error("Mega V2 candidate exceeds max bottle count before ads.");
  }

  return {
    board,
    capacities: board.map((_, index) => index === 0 ? megaCapacity : defaultCapacity),
    defaultCapacity,
    megaBottleIndex: 0,
    megaCapacity,
    targetColor,
    blockerPalette,
    metadata,
  };
}

function calculateMegaActiveBottleBudget(options) {
  const desiredFill = Math.max(1, options.capacity * options.profile.targetMegaActiveFillRatio);
  const denseBlockerLength = Math.max(1, Math.ceil(options.capacity * 0.75));
  const minBlockerOnly = Math.min(
    options.blockerColorCount,
    Math.max(3, Math.ceil(options.targetSourceCount * 0.3)));
  const estimatedLayers = options.targetSourceLayerCount + minBlockerOnly * denseBlockerLength;
  const densityBasedActiveCount = Math.ceil(estimatedLayers / desiredFill);
  const requestedActiveCount = Math.max(
    options.targetSourceCount + minBlockerOnly,
    densityBasedActiveCount,
    options.profile.minMegaActiveBottleCount);
  const maxActiveByGrid = Math.max(1, options.maxPhysicalBottles - 1 - options.helperCount - 3);
  const activeBottleCount = Math.min(options.profile.maxMegaActiveBottleCount, maxActiveByGrid, requestedActiveCount);
  const blockerOnlyBottleCount = Math.max(minBlockerOnly, activeBottleCount - options.targetSourceCount);
  return {
    activeBottleCount: options.targetSourceCount + blockerOnlyBottleCount,
    blockerOnlyBottleCount,
    desiredFill,
  };
}

function chooseDenseBlockerBottleLength(capacity, random) {
  const minPreferred = Math.max(1, Math.ceil(capacity * 0.75));
  if (random() < 0.75) return Math.max(minPreferred, capacity - 1);
  return randomInt(random, minPreferred, capacity);
}

function rebalanceMegaDensity(candidate, profile, random) {
  if (!candidate.metadata?.blockerOnlyIndexes) return candidate;
  const capacities = candidate.capacities || candidate.board.map((_, index) => index === candidate.megaBottleIndex ? candidate.megaCapacity : candidate.defaultCapacity || 4);
  const sparseLimit = index => Math.floor(capacities[index] * 0.5);
  const activeSet = new Set(activeNormalIndexes(candidate));
  const removable = candidate.metadata.blockerOnlyIndexes
    .filter(index => activeSet.has(index) && candidate.board[index].length > 0 && candidate.board[index].length <= sparseLimit(index))
    .sort((left, right) => candidate.board[left].length - candidate.board[right].length);

  for (const from of removable) {
    const layers = candidate.board[from].slice();
    const receivers = candidate.metadata.blockerOnlyIndexes
      .filter(index => index !== from && candidate.board[index].length > 0)
      .sort((left, right) => (capacities[right] - candidate.board[right].length) - (capacities[left] - candidate.board[left].length));
    let cursor = 0;
    for (const to of receivers) {
      while (cursor < layers.length && candidate.board[to].length < capacities[to]) {
        candidate.board[to].push(layers[cursor++]);
      }
      if (cursor >= layers.length) break;
    }
    if (cursor >= layers.length) candidate.board[from] = [];
  }

  candidate.metadata.blockerOnlyIndexes = candidate.metadata.blockerOnlyIndexes.filter(index => candidate.board[index].length > 0);
  compactEmptyActiveBottles(candidate);
  return candidate;
}

function compactEmptyActiveBottles(candidate) {
  if (!candidate.metadata) return;
  const removable = new Set((candidate.metadata.blockerOnlyIndexes || []).filter(index => candidate.board[index].length === 0));
  if (removable.size === 0) return;
  const indexMap = new Map();
  const nextBoard = [];
  const nextCapacities = candidate.capacities ? [] : null;
  for (let i = 0; i < candidate.board.length; i++) {
    if (removable.has(i)) continue;
    indexMap.set(i, nextBoard.length);
    nextBoard.push(candidate.board[i]);
    if (nextCapacities) nextCapacities.push(candidate.capacities[i]);
  }
  candidate.board = nextBoard;
  if (nextCapacities) candidate.capacities = nextCapacities;
  candidate.megaBottleIndex = indexMap.get(candidate.megaBottleIndex);
  candidate.metadata.targetGroupSources = candidate.metadata.targetGroupSources.map(index => indexMap.get(index));
  candidate.metadata.blockerOnlyIndexes = candidate.metadata.blockerOnlyIndexes.filter(index => indexMap.has(index)).map(index => indexMap.get(index));
  candidate.metadata.normalHelperIndexes = (candidate.metadata.normalHelperIndexes || []).filter(index => indexMap.has(index)).map(index => indexMap.get(index));
  candidate.metadata.targetGroups = (candidate.metadata.targetGroups || []).map(group => ({ ...group, bottleIndex: indexMap.get(group.bottleIndex) }));
}

function evaluateMegaDensityMetrics(candidate) {
  const activeIndexes = activeNormalIndexes(candidate);
  let activeCapacity = 0;
  let occupiedLayers = 0;
  let sparseBottleCount = 0;
  let singleLayerBottleCount = 0;
  let activeBottlesWithFreeSlots = 0;
  const capacities = candidate.capacities || candidate.board.map((_, index) => index === candidate.megaBottleIndex ? candidate.megaCapacity : candidate.defaultCapacity || 4);

  for (const index of activeIndexes) {
    const capacity = capacities[index];
    const filled = candidate.board[index].length;
    activeCapacity += capacity;
    occupiedLayers += filled;
    if (filled <= Math.floor(capacity * 0.5)) sparseBottleCount++;
    if (filled === 1) singleLayerBottleCount++;
    if (filled < capacity) activeBottlesWithFreeSlots++;
  }

  const activeBottleCount = activeIndexes.length;
  const activeFreeSlots = activeCapacity - occupiedLayers;
  return {
    activeBottleCount,
    normalHelperCount: normalHelperIndexes(candidate).length,
    averageActiveFill: activeBottleCount === 0 ? 0 : occupiedLayers / activeBottleCount,
    activeFillRatio: activeCapacity === 0 ? 1 : occupiedLayers / activeCapacity,
    activeFreeSlots,
    activeFreeRatio: activeCapacity === 0 ? 0 : activeFreeSlots / activeCapacity,
    sparseBottleCount,
    sparseBottleRatio: activeBottleCount === 0 ? 0 : sparseBottleCount / activeBottleCount,
    singleLayerBottleCount,
    distributedActiveFreeRatio: activeBottleCount === 0 ? 0 : activeBottlesWithFreeSlots / activeBottleCount,
  };
}

function activeNormalIndexes(candidate) {
  const helpers = new Set(normalHelperIndexes(candidate));
  const ads = new Set(candidate.metadata?.adBottleIndexes || []);
  const indexes = [];
  for (let i = 0; i < candidate.board.length; i++) {
    if (i === candidate.megaBottleIndex || helpers.has(i) || ads.has(i)) continue;
    if (candidate.board[i].length === 0) continue;
    indexes.push(i);
  }
  return indexes;
}

function normalHelperIndexes(candidate) {
  if (candidate.metadata?.normalHelperIndexes) return candidate.metadata.normalHelperIndexes.slice();
  const indexes = [];
  for (let i = 0; i < candidate.board.length; i++) {
    if (i !== candidate.megaBottleIndex && candidate.board[i].length === 0) indexes.push(i);
  }
  return indexes;
}

function distributeTargetGroupsV2(total, capacity, profile, random) {
  const maxGroup = Math.max(1, Math.min(profile.maxMegaTargetGroupSize, capacity - 1));
  const minSources = Math.ceil(total / maxGroup);
  const maxSources = total;
  const preferredSources = Math.max(minSources, Math.min(maxSources, Math.ceil(total * (profile.hard ? 0.82 : 0.7))));
  const count = randomInt(random, Math.min(maxSources, preferredSources), maxSources);
  const groups = Array(count).fill(1);
  let remaining = total - count;
  while (remaining > 0) {
    const candidates = groups
      .map((value, index) => ({ value, index }))
      .filter(entry => entry.value < maxGroup && (entry.value < 2 || random() < 0.15));
    if (candidates.length === 0) break;
    const picked = candidates[randomInt(random, 0, candidates.length - 1)].index;
    groups[picked]++;
    remaining--;
  }
  if (remaining > 0) throw new Error("Cannot distribute Mega V2 target groups.");
  return shuffle(groups, random);
}

function makeBlockerOnlyBottle(topColor, blockerPalette, patternSet, pairCounts, random, capacity, preferredLength = null) {
  const minDenseLength = Math.max(1, Math.ceil(capacity * 0.75));
  const length = preferredLength || randomInt(random, minDenseLength, capacity);
  const bottle = [];
  for (let i = 0; i < length - 1; i++) bottle.push(blockerPalette[randomInt(random, 0, blockerPalette.length - 1)]);
  bottle.push(topColor);
  mutateUntilDiverse(bottle, -1, blockerPalette, patternSet, pairCounts, random, capacity);
  return bottle;
}

function mutateUntilDiverse(bottle, targetColor, blockerPalette, patternSet, pairCounts, random, capacity) {
  for (let attempt = 0; attempt < 16; attempt++) {
    const pattern = bottle.join(",");
    if (!patternSet.has(pattern) && adjacentPairsWithinLimit(bottle, pairCounts)) {
      patternSet.add(pattern);
      for (let i = 0; i < bottle.length - 1; i++) {
        const key = `${bottle[i]}>${bottle[i + 1]}`;
        pairCounts.set(key, (pairCounts.get(key) || 0) + 1);
      }
      return;
    }
    if (bottle.length < capacity && random() < 0.45) {
      bottle.unshift(blockerPalette[randomInt(random, 0, blockerPalette.length - 1)]);
    } else if (bottle.length > 1) {
      const mutableIndexes = bottle
        .map((color, index) => ({ color, index }))
        .filter(entry => entry.index < bottle.length - 1 && entry.color !== targetColor)
        .map(entry => entry.index);
      if (mutableIndexes.length === 0) continue;
      const index = mutableIndexes[randomInt(random, 0, mutableIndexes.length - 1)];
      bottle[index] = blockerPalette[randomInt(random, 0, blockerPalette.length - 1)];
    }
  }
  throw new Error("Could not create diverse Mega V2 bottle pattern.");
}

function adjacentPairsWithinLimit(bottle, pairCounts) {
  for (let i = 0; i < bottle.length - 1; i++) {
    if ((pairCounts.get(`${bottle[i]}>${bottle[i + 1]}`) || 0) >= DEFAULTS.maxAdjacentPairRepeats) return false;
  }
  return true;
}

function validateMegaCandidate(candidate, profile) {
  if (candidate.megaCapacity < 12 || candidate.megaCapacity > 20) throw new Error("Mega capacity out of range.");
  if (candidate.board.length > 40) throw new Error("Mega candidate exceeds 40 bottles.");
  if (candidate.board[candidate.megaBottleIndex].length < 1) throw new Error("Mega bottle needs visible target layer.");
  const totalTarget = candidate.board.reduce((sum, bottle) => sum + bottle.filter(color => color === candidate.targetColor).length, 0);
  if (totalTarget !== candidate.megaCapacity) throw new Error("Mega target count must exactly fill Mega bottle.");
  const filledNormalPatterns = new Set();
  for (let i = 0; i < candidate.board.length; i++) {
    const bottle = candidate.board[i];
    if (bottle.length > candidate.capacities[i]) throw new Error("Mega candidate bottle overflow.");
    if (i === candidate.megaBottleIndex || bottle.length === 0) continue;
    if (bottle.length === candidate.capacities[i] && bottle.every(color => color === candidate.targetColor)) {
      throw new Error("Filled normal bottle is mono targetColor.");
    }
    const pattern = bottle.join(",");
    if (filledNormalPatterns.has(pattern)) throw new Error("Duplicate filled normal bottle pattern.");
    filledNormalPatterns.add(pattern);
  }
  const staticMetrics = evaluateStaticMegaMetrics(candidate);
  if (staticMetrics.activeFillRatio < profile.minMegaActiveFillRatio) throw new Error("Mega active fill ratio too low.");
  if (staticMetrics.activeFreeRatio > profile.maxMegaActiveFreeRatio) throw new Error("Mega active free ratio too high.");
  if (staticMetrics.sparseBottleRatio > profile.maxMegaSparseBottleRatio) throw new Error("Mega sparse bottle ratio too high.");
  if (staticMetrics.singleLayerBottleCount > profile.maxMegaSingleLayerBottleCount) throw new Error("Mega single-layer active bottles too high.");
  if (staticMetrics.buriedTargetRatio < profile.minMegaBuriedTargetRatio) throw new Error("Mega buried target ratio too low.");
  if (staticMetrics.deepBuriedTargetRatio < profile.minMegaDeepBuriedTargetRatio) throw new Error("Mega deep buried target ratio too low.");
  if (staticMetrics.uniqueVisibleTopColors < profile.minMegaUniqueTopColorCount) throw new Error("Mega top color diversity too low.");
  if (staticMetrics.maxTopColorShare > profile.maxMegaTopColorShare) throw new Error("Mega top color share too high.");
  if (staticMetrics.uniqueBottlePatternRatio < profile.minMegaUniqueBottlePatternRatio) throw new Error("Mega bottle pattern diversity too low.");
  return staticMetrics;
}

function solveMegaCandidate(candidate, profile) {
  const startedAt = Date.now();
  const board = candidate.board.map(bottle => bottle.slice());
  const moves = [];
  let visitedStates = 1;

  while (!isMegaSolved(board, candidate)) {
    if (moves.length >= profile.megaSolverMaxDepth || visitedStates >= profile.megaSolverMaxStates) {
      return {
        success: false,
        status: "limit",
        visitedStates,
        elapsedMs: Date.now() - startedAt,
        solution: null,
      };
    }

    const blockerMove = findBestTargetBlockerMove(board, candidate);
    const previousMove = moves.length > 0 ? moves[moves.length - 1] : null;
    const excludedImmediateFillSource = blockerMove != null && previousMove != null && previousMove.toBottle !== 1
      ? previousMove.fromBottle - 1
      : -1;
    const exposedTargetSource = moves.length >= profile.minMegaMovesBeforeFirstFill || blockerMove == null
      ? findExposedTargetSource(board, candidate, excludedImmediateFillSource, blockerMove == null)
      : -1;
    if (exposedTargetSource >= 0) {
      const group = topGroup(board[exposedTargetSource]);
      const move = { from: exposedTargetSource, to: candidate.megaBottleIndex, color: group.color, amount: group.amount };
      if (!isLegalMegaMove(board, candidate, move)) return failedMegaSolve("illegal_target_fill", visitedStates, startedAt);
      applyMegaMoveInPlace(board, move);
      moves.push({ fromBottle: move.from + 1, toBottle: move.to + 1 });
      visitedStates++;
      continue;
    }

    if (blockerMove == null) return failedMegaSolve("no_blocker_move", visitedStates, startedAt);
    applyMegaMoveInPlace(board, blockerMove);
    moves.push({ fromBottle: blockerMove.from + 1, toBottle: blockerMove.to + 1 });
    visitedStates++;
  }

  return {
    success: true,
    status: "solved",
    visitedStates,
    elapsedMs: Date.now() - startedAt,
    solution: { stepCount: moves.length, moves },
  };
}

function failedMegaSolve(status, visitedStates, startedAt) {
  return {
    success: false,
    status,
    visitedStates,
    elapsedMs: Date.now() - startedAt,
    solution: null,
  };
}

function findExposedTargetSource(board, candidate, excludedSource = -1, allowExcludedFallback = true) {
  for (const index of candidate.metadata.targetGroupSources) {
    if (index === excludedSource) continue;
    const bottle = board[index];
    if (bottle.length > 0 && bottle[bottle.length - 1] === candidate.targetColor) return index;
  }
  if (!allowExcludedFallback) return -1;
  for (const index of candidate.metadata.targetGroupSources) {
    const bottle = board[index];
    if (bottle.length > 0 && bottle[bottle.length - 1] === candidate.targetColor) return index;
  }
  return -1;
}

function findBestTargetBlockerMove(board, candidate) {
  const moves = [];
  for (const from of candidate.metadata.targetGroupSources) {
    const source = board[from];
    if (source.length === 0 || !source.includes(candidate.targetColor) || source[source.length - 1] === candidate.targetColor) continue;
    const group = topGroup(source);
    for (let to = 0; to < board.length; to++) {
      if (from === to) continue;
      const target = board[to];
      const move = { from, to, color: group.color, amount: group.amount };
      if (to === candidate.megaBottleIndex || !isLegalMegaMove(board, candidate, move)) continue;
      const exposesTarget = source.length > group.amount && source[source.length - group.amount - 1] === candidate.targetColor;
      const isHelper = candidate.metadata.normalHelperIndexes.includes(to);
      const score =
        (target.length > 0 ? -80 : 40) +
        (exposesTarget ? -50 : 0) +
        (isHelper ? 25 : 0) +
        target.length;
      moves.push({ ...move, score });
    }
  }
  moves.sort((left, right) => left.score - right.score || left.from - right.from || left.to - right.to);
  return moves[0] || null;
}

function isLegalMegaMove(board, candidate, move) {
  if (move.from === candidate.megaBottleIndex || move.from === move.to) return false;
  const source = board[move.from];
  const target = board[move.to];
  if (!source || !target || source.length === 0) return false;
  const group = topGroup(source);
  if (group.color !== move.color || group.amount !== move.amount) return false;
  if (target.length + group.amount > candidate.capacities[move.to]) return false;
  if (move.to === candidate.megaBottleIndex && group.color !== candidate.targetColor) return false;
  return target.length === 0 || target[target.length - 1] === group.color;
}

function replayMegaSolutionExact(candidate, moves) {
  const board = candidate.board.map(bottle => bottle.slice());
  for (const move of moves) {
    const from = move.fromBottle - 1;
    const to = move.toBottle - 1;
    if (from === candidate.megaBottleIndex) return { success: false, reason: "mega_source" };
    if (from < 0 || to < 0 || from >= board.length || to >= board.length || from === to) return { success: false, reason: "bad_index" };
    const source = board[from];
    const target = board[to];
    if (source.length === 0) return { success: false, reason: "empty_source" };
    const group = topGroup(source);
    if (target.length + group.amount > candidate.capacities[to]) return { success: false, reason: "target_capacity" };
    if (to === candidate.megaBottleIndex && group.color !== candidate.targetColor) return { success: false, reason: "mega_color" };
    if (target.length > 0 && target[target.length - 1] !== group.color) return { success: false, reason: "target_color" };
    for (let i = 0; i < group.amount; i++) target.push(source.pop());
  }
  return isMegaSolved(board, candidate)
    ? { success: true, reason: "" }
    : { success: false, reason: "mega_incomplete" };
}

function evaluateMegaCandidate(candidate, moves, solverVisitedStates = 0) {
  const staticMetrics = evaluateStaticMegaMetrics(candidate);
  const runtime = evaluateMegaSolutionMetrics(candidate, moves);
  return {
    ...staticMetrics,
    ...runtime,
    solutionStepCount: moves.length,
    solverVisitedStates,
  };
}

function evaluateStaticMegaMetrics(candidate) {
  const topCounts = new Map();
  let nonEmptyNormal = 0;
  const patterns = new Set();
  let targetSourceBottleCount = 0;
  let buried = 0;
  let deepBuried = 0;
  let targetGroupCount = 0;
  const density = evaluateMegaDensityMetrics(candidate);

  for (let i = 0; i < candidate.board.length; i++) {
    if (i === candidate.megaBottleIndex) continue;
    const bottle = candidate.board[i];
    if (bottle.length === 0) continue;
    nonEmptyNormal++;
    patterns.add(bottle.join(","));
    const top = bottle[bottle.length - 1];
    topCounts.set(top, (topCounts.get(top) || 0) + 1);
    const targetGroups = findTargetGroups(bottle, candidate.targetColor);
    if (targetGroups.length > 0) targetSourceBottleCount++;
    for (const group of targetGroups) {
      targetGroupCount++;
      const blockersAbove = bottle.length - group.topIndex - 1;
      if (blockersAbove >= 1) buried++;
      if (blockersAbove >= 2) deepBuried++;
    }
  }

  const maxTop = Math.max(0, ...topCounts.values());
  return {
    ...density,
    targetSourceBottleCount,
    buriedTargetRatio: targetGroupCount === 0 ? 0 : buried / targetGroupCount,
    deepBuriedTargetRatio: targetGroupCount === 0 ? 0 : deepBuried / targetGroupCount,
    uniqueVisibleTopColors: topCounts.size,
    maxTopColorShare: nonEmptyNormal === 0 ? 1 : maxTop / nonEmptyNormal,
    uniqueBottlePatternRatio: nonEmptyNormal === 0 ? 1 : patterns.size / nonEmptyNormal,
  };
}

function evaluateMegaSolutionMetrics(candidate, moves) {
  const board = candidate.board.map(bottle => bottle.slice());
  let movesBeforeFirstMegaPour = 0;
  let sawMega = false;
  let nonMegaMoveCount = 0;
  let crossBottleBlockerMoves = 0;
  let normalHelperMoves = 0;
  let rehandledBlockerCount = 0;
  let consecutiveMega = 0;
  let maxConsecutiveMegaPours = 0;
  const sourceCounts = new Map();
  const destCounts = new Map();
  const distinctSourceBottles = new Set();
  const distinctDestinationBottles = new Set();

  for (const move of moves) {
    const from = move.fromBottle - 1;
    const to = move.toBottle - 1;
    const source = board[from];
    const target = board[to];
    const targetWasEmpty = target.length === 0;
    const group = topGroup(source);
    const isMegaFill = to === candidate.megaBottleIndex;
    if (!sawMega && !isMegaFill) movesBeforeFirstMegaPour++;
    if (isMegaFill) {
      sawMega = true;
      consecutiveMega++;
      maxConsecutiveMegaPours = Math.max(maxConsecutiveMegaPours, consecutiveMega);
    } else {
      consecutiveMega = 0;
      nonMegaMoveCount++;
      if (!targetWasEmpty) crossBottleBlockerMoves++;
      if (targetWasEmpty) normalHelperMoves++;
      if ((sourceCounts.get(from) || 0) > 0) rehandledBlockerCount++;
    }
    sourceCounts.set(from, (sourceCounts.get(from) || 0) + 1);
    destCounts.set(to, (destCounts.get(to) || 0) + 1);
    distinctSourceBottles.add(from);
    if (!isMegaFill) distinctDestinationBottles.add(to);
    for (let i = 0; i < group.amount; i++) target.push(source.pop());
  }

  return {
    movesBeforeFirstMegaPour,
    nonMegaMoveCount,
    nonMegaMoveRatio: moves.length === 0 ? 0 : nonMegaMoveCount / moves.length,
    crossBottleBlockerMoves,
    normalHelperMoves,
    rehandledBlockerCount,
    distinctSourceBottles: distinctSourceBottles.size,
    distinctDestinationBottles: distinctDestinationBottles.size,
    distinctNonMegaDestinationBottles: distinctDestinationBottles.size,
    maxConsecutiveMegaPours,
    templatePenalty: templatePenalty(moves),
  };
}

function scoreMegaCandidate(metrics, profile, band) {
  if (metrics.solutionStepCount < (band.minShortestStepCount || 0)) return { accepted: false, reason: "solution_too_short", score: 0 };
  if (metrics.solutionStepCount > (band.maxShortestStepCount || Infinity)) return { accepted: false, reason: "solution_too_long", score: 0 };
  if (metrics.movesBeforeFirstMegaPour < profile.minMegaMovesBeforeFirstFill) return { accepted: false, reason: "first_mega_too_early", score: 0 };
  if (metrics.crossBottleBlockerMoves < profile.minMegaCrossBottleBlockerMoves) return { accepted: false, reason: "not_enough_cross_moves", score: 0 };
  if (metrics.nonMegaMoveRatio < profile.minMegaNonMegaMoveRatio) return { accepted: false, reason: "non_mega_ratio_low", score: 0 };
  if (metrics.maxConsecutiveMegaPours > profile.maxMegaConsecutiveFillMoves) return { accepted: false, reason: "mega_fill_streak", score: 0 };
  if (metrics.distinctNonMegaDestinationBottles < 3) return { accepted: false, reason: "few_non_mega_destinations", score: 0 };
  if (metrics.templatePenalty >= 3) return { accepted: false, reason: "template_solution", score: 0 };
  const targetMid = ((band.minShortestStepCount || 20) + (band.maxShortestStepCount || 80)) / 2;
  const stepScore = 100 - Math.abs(metrics.solutionStepCount - targetMid);
  const fillDensityScore = Math.max(0, 1 - Math.abs(metrics.activeFillRatio - profile.targetMegaActiveFillRatio)) * 45;
  const sparseBottlePenalty = metrics.sparseBottleCount * 25 + metrics.singleLayerBottleCount * 80;
  const distributedFreeSpacePenalty = Math.max(0, metrics.distributedActiveFreeRatio - (1 - profile.megaFreeCapacityConcentrationRatio)) * 50;
  const score =
    stepScore +
    metrics.uniqueVisibleTopColors * 8 +
    metrics.crossBottleBlockerMoves * 4 +
    metrics.distinctNonMegaDestinationBottles * 6 +
    metrics.rehandledBlockerCount * 3 +
    fillDensityScore -
    metrics.templatePenalty * 30 -
    metrics.maxTopColorShare * 40 -
    sparseBottlePenalty -
    distributedFreeSpacePenalty;
  return { accepted: true, reason: "", score };
}

function templatePenalty(moves) {
  let penalty = 0;
  for (let i = 0; i < moves.length - 1; i++) {
    const first = moves[i];
    const second = moves[i + 1];
    if (first.fromBottle === second.fromBottle && second.toBottle === 1 && first.toBottle !== 1) penalty++;
  }
  return penalty;
}

function topGroup(bottle) {
  const color = bottle[bottle.length - 1];
  let amount = 0;
  for (let i = bottle.length - 1; i >= 0 && bottle[i] === color; i--) amount++;
  return { color, amount };
}

function applyMegaMove(board, capacities, move) {
  const next = board.map(bottle => bottle.slice());
  const source = next[move.from];
  const target = next[move.to];
  for (let i = 0; i < move.amount; i++) target.push(source.pop());
  return next;
}

function applyMegaMoveInPlace(board, move) {
  const source = board[move.from];
  const target = board[move.to];
  for (let i = 0; i < move.amount; i++) target.push(source.pop());
}

function isMegaSolved(board, candidate) {
  const mega = board[candidate.megaBottleIndex];
  return mega.length === candidate.megaCapacity && mega.every(color => color === candidate.targetColor);
}

function megaHeuristic(board, candidate) {
  const mega = board[candidate.megaBottleIndex];
  let blockersAboveTargets = 0;
  let buriedTargets = 0;
  for (let i = 0; i < board.length; i++) {
    if (i === candidate.megaBottleIndex) continue;
    const bottle = board[i];
    const groups = findTargetGroups(bottle, candidate.targetColor);
    for (const group of groups) {
      const blockers = bottle.length - group.topIndex - 1;
      blockersAboveTargets += blockers;
      if (blockers > 0) buriedTargets++;
    }
  }
  return (candidate.megaCapacity - mega.length) * 1.5 + blockersAboveTargets * 0.9 + buriedTargets * 0.4;
}

function findTargetGroups(bottle, targetColor) {
  const groups = [];
  let i = 0;
  while (i < bottle.length) {
    if (bottle[i] !== targetColor) {
      i++;
      continue;
    }
    const start = i;
    while (i < bottle.length && bottle[i] === targetColor) i++;
    groups.push({ bottomIndex: start, topIndex: i - 1, size: i - start });
  }
  return groups;
}

function pickBalancedColor(colors, loads, random) {
  const minLoad = Math.min(...colors.map(color => loads.get(color) || 0));
  const candidates = colors.filter(color => (loads.get(color) || 0) <= minLoad + 1);
  return candidates[randomInt(random, 0, candidates.length - 1)];
}

function countFailure(map, reason) {
  map.set(reason, (map.get(reason) || 0) + 1);
}

function rng(seed) {
  let s = seed >>> 0;
  return () => {
    s = (Math.imul(1664525, s) + 1013904223) >>> 0;
    return s / 4294967296;
  };
}

function seedFor(seed, levelNumber, attempt, salt) {
  return (salt ^ Math.imul(seed >>> 0, 2654435761) ^ Math.imul(levelNumber, 2246822519) ^ Math.imul(attempt + 1, 3266489917)) >>> 0;
}

function randomInt(random, min, max) {
  return min + Math.floor(random() * (max - min + 1));
}

function weighted(random, rows, fallback) {
  const total = rows.reduce((sum, row) => sum + Math.max(0, row.weight), 0);
  if (total <= 0) return fallback;
  let roll = random() * total;
  for (const row of rows) {
    roll -= Math.max(0, row.weight);
    if (roll <= 0) return row.value;
  }
  return rows[rows.length - 1].value;
}

function shuffle(items, random) {
  const out = items.slice();
  for (let i = out.length - 1; i > 0; i--) {
    const j = Math.floor(random() * (i + 1));
    [out[i], out[j]] = [out[j], out[i]];
  }
  return out;
}

function megaStateKey(board) {
  return board.map(bottle => bottle.join(".")).join("|");
}

module.exports = {
  buildMegaLevelV2,
  evaluateMegaCandidate,
  replayMegaSolutionExact,
  solveMegaCandidate,
  validateMegaCandidate,
  templatePenalty,
  evaluateMegaDensityMetrics,
  rebalanceMegaDensity,
};
